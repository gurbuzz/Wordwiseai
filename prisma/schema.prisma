datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  username  String
  createdAt DateTime @default(now())
  
  // User'ın oyun sonuçlarıyla ilişkisi
  GameResults GameResult[]
}

model DailyWord {
  id        String   @id @default(uuid())
  word      String
  createdAt DateTime @default(now())
  date      DateTime // hangi güne ait (günlük kelime)
}

model GameResult {
  id          String   @id @default(uuid())
  userId      String
  promptCount Int
  attemptCount Int
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
}
